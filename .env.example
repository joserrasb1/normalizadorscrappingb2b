# Database
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
# For local dev with SQLite: DATABASE_URL=sqlite:///./dev.db

# App
ENV=dev
SECRET_KEY=change-me-in-production

# URL pública de la landing (Cloudflare Pages). Es a donde vuelve el usuario
# tras pagar en Stripe. Déjala vacía si la landing y la API comparten origen.
APP_URL=https://normalizadorscrappingb2b.pages.dev

# CORS
# Lista de orígenes autorizados a llamar a la API con cookie de sesión.
# Por defecto: la landing + el propio host de la API (auto con RENDER=true).
#   ALLOWED_ORIGINS=https://normalizadorscrappingb2b.pages.dev
#   ALLOWED_ORIGINS=*   -> API pública sin credenciales (sin cookie)
ALLOWED_ORIGINS=https://normalizadorscrappingb2b.pages.dev

# Cookies de sesión
# Vacío = automático: none+secure en producción, lax en local.
# Con landing y API en dominios distintos (pages.dev / onrender.com) hace falta
# SameSite=None + Secure; el valor automático ya lo resuelve.
SESSION_COOKIE_SAMESITE=
SESSION_COOKIE_SECURE=false

# Stripe
# STRIPE_SECRET_KEY=sk_test_...   (o sk_live_...)
# STRIPE_PRICE_BASIC=price_...     (price ID del producto Basic, 29 €/mes)
# STRIPE_PRICE_PRO=price_...       (price ID del producto Pro, 49 €/mes)
# STRIPE_WEBHOOK_SECRET=whsec_...  (secreto del endpoint de webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# Redis (later)
REDIS_URL=

# R2 (later)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Database
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
# For local dev with SQLite: DATABASE_URL=sqlite:///./dev.db

# App
ENV=dev
SECRET_KEY=change-me-in-production

# URL pública de la landing (Cloudflare Pages). Es a donde vuelve el usuario
# tras pagar en Stripe. Déjala vacía si la landing y la API comparten origen.
APP_URL=https://normalizadorscrappingb2b.pages.dev

# CORS
# Con la landing en otro dominio (pages.dev) hay que acotar los orígenes y
# activar credenciales para que viaje la cookie de sesión:
#   ALLOWED_ORIGINS=https://normalizadorscrappingb2b.pages.dev
ALLOWED_ORIGINS=*

# Cookies de sesión
# Cross-site (landing en pages.dev, API en onrender.com) => SameSite=None
# y Secure (obligatorio). En local (http) déjalos en lax / false.
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

# Stripe
# STRIPE_SECRET_KEY=sk_test_...   (o sk_live_...)
# STRIPE_PRICE_BASIC=price_...     (price ID del producto Basic, 29 €/mes)
# STRIPE_PRICE_PRO=price_...       (price ID del producto Pro, 49 €/mes)
# STRIPE_WEBHOOK_SECRET=whsec_...  (secreto del endpoint de webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# Redis (later)
REDIS_URL=

# R2 (later)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
